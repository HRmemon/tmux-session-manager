#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# tma — list all tmux sessions and attach to selected
#
# Usage:
#   tma                   fzf list of sessions, select one to attach
#
# Keybindings:
#   Enter    Attach/switch to session
#   Ctrl-o   Open in a new terminal
#   Ctrl-d   Kill session (with confirmation)
# ═══════════════════════════════════════════════════════════════════════════
exec "$(dirname "$(readlink -f "$0")")/tmux-manager" "$@"
